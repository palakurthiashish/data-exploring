   "source": [
    "import pandas as pd \n",
    "df = pd.read_csv(\"Food_Quality_Regression_Day14_Dataset.csv\")\n",
    "print(df.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "de3d3b73-95be-47ea-9d7b-6b886edf3159",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shape of X: (120, 4)\n",
      "Shape of y: (120,)\n",
      "Data types of X:\n",
      "temperature     float64\n",
      "moisture        float64\n",
      "storage_days      int64\n",
