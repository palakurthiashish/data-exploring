      "3                 51.62                48.460440          3.159560\n",
      "4                 57.36                56.495550          0.864450\n"
     ]
    }
   ],
   "source": [
    "#6.Display 5 sample test-set predictions. For each sample, show the actual quality_score, predicted quality_score, and prediction error.\n",
    "import pandas as pd\n",
    "\n",
    "results = pd.DataFrame({\n",
    "    \"Actual quality_score\": y_test.values,\n",
    "    \"Predicted quality_score\": y_pred\n",
    "})\n",
    "\n",
    "results[\"Prediction Error\"] = (\n",
    "    results[\"Actual quality_score\"] - results[\"Predicted quality_score\"]\n",
    ")\n",
    "\n",
    "print(results.head(5))"
   ]
  },
